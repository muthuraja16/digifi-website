# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.

# Site
SITE_URL=https://www.digifi.in
NEXT_PUBLIC_SITE_URL=https://www.digifi.in
LEAD_ALERT_EMAIL=hello@digifi.in
WHATSAPP_NUMBER=918892834327

# Supabase (Stage 8, region ap-south-1 Mumbai)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Stage 9, domain mail.digifi.in)
RESEND_API_KEY=

# Cloudflare Turnstile (Stage 9)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (Stage 14)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Google Maps Embed (Stage 11, deferred until the office move)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Google Reviews (Stage 12, off by default)
NEXT_PUBLIC_SHOW_GOOGLE_REVIEWS=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Sentry (Stage 19)
NEXT_PUBLIC_SENTRY_DSN=
